# Compose screenshot-test reference images: regenerated on demand and copied into fastlane metadata
# by fastlane/copy_screenshots.sh, so they are intermediates, not committed artifacts.
**/src/screenshotTest*/reference/

# Play Store screenshots: only en-US is tracked. It is the listing every language without its
# own screenshots falls back to, and PNGs are stored whole in every commit, so tracking the full
# set costs tens of MB of permanent history per render. All other locales are generated on demand
# (fastlane/generate_screenshots.sh) and uploaded straight from the working tree.
fastlane/metadata/android/*/images/phoneScreenshots/*.png
!fastlane/metadata/android/en-US/images/phoneScreenshots/*.png


    <!-- Guided tour -->
    <string name="tour_analyzer_intro_body">ראה מה בעצם ממלא את האחסון שלך. Analyzer ממפה היכן המקום שלך הולך. כל אחד מהכרטיסים האלה הוא שבב אחסון בהתקן שלך.</string>
    <string name="tour_analyzer_storage_body">פתח אחסון כדי לפרק אותו ליישומים, מדיה וקבצים, ואז המשך להקש כדי לאתר אחר האשמים הגדולים ביותר.</string>

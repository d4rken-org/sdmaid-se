    <string name="squeezer_video_settings_category_label">Videoinnstillinger</string>
    <string name="squeezer_type_jpeg_title">JPEG</string>
    <string name="squeezer_type_jpeg_description">Inkluder JPEG-bilder (.jpg, .jpeg). Omkoding bruker Androids innebygde JPEG-enkoder. Dato, plassering og annen EXIF-metadata beholdes.</string>
    <string name="squeezer_type_webp_title">WebP</string>
    <string name="squeezer_type_webp_description">Inkluder WebP-bilder (.webp). Omkoding bruker Androids innebygde WebP-enkoder. Dato, plassering og annen EXIF-metadata beholdes.</string>
    <string name="squeezer_type_heic_title">HEIC/HEIF</string>
    <string name="squeezer_type_heic_description">Inkluder HEIC/HEIF-bilder (.heic, .heif). Dato, plassering og annen EXIF-metadata beholdes. HDR-forsterkningsmapper, dybdedata og Live/Motion Photo-søsken kan ikke bevares; flerbilde-filer hoppes over.</string>
    <string name="squeezer_type_video_title">MP4 Video</string>
    <string name="squeezer_type_video_description">Inkluder MP4-videofiler (.mp4). Videosporen omkodes med lavere bithastighet av enhetens eget videoenkodar, lydsporen kopieres uendret, og filen forblir en MP4.</string>
    <string name="squeezer_skip_compressed_title">Hopp over allerede komprimerte</string>
    <string name="squeezer_skip_compressed_description">Hopp over filer som allerede er komprimert av SD Maid.</string>
    <string name="squeezer_exif_marker_title">Skriv EXIF-markør</string>
    <string name="squeezer_exif_marker_description">Legg til en markør i bildets EXIF-brukerkommentarfelt for å forhindre rekomprimering selv om komprimeringshistorikken slettes.</string>
    <string name="squeezer_include_lossy_aux_title">Komprimer HDR &amp; dybde-bilder</string>
    <string name="squeezer_include_lossy_aux_description">Inkluder bilder med HDR- eller dybdedata. Komprimering fjerner det: HDR-bilder blir til vanlige bilder, portrettbilder mister bakgrunnsuskarpheten. HEIC-filer med flere bilder forblir hoppet over.</string>
    <string name="squeezer_include_motion_photos_title">Komprimer Motion Photos</string>
    <string name="squeezer_include_motion_photos_description">Inkluder Motion Photos. Komprimering beholder stillbildet og fjerner videoklippet.</string>
    <string name="squeezer_include_oversized_title">Komprimer veldig store bilder</string>
    <string name="squeezer_include_oversized_description">Inkluder bilder bredere eller høyere enn 8192 piksler. Komprimering halverer også oppløsningen deres.</string>

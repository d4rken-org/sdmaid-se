    <string name="squeezer_markers_dialog_title">Om disse markeringene</string>
    <string name="squeezer_markers_compressed_before_description">SD Maid komprimerte allerede denne filen. Komprimering av den igjen koster kvalitet og sparer lite.</string>
    <string name="squeezer_markers_hdr_depth_description">Dette bildet har HDR- eller dybdedata som komprimering ikke kan beholde. Et HDR-bilde blir til et vanlig bilde, og et portrettbilde mister dybdedataene som brukes til bakgrunnsuskarpheten.</string>
    <string name="squeezer_markers_motion_photo_description">Dette er et Motion Photo. Komprimering beholder stillbildet og fjerner videoklippet.</string>
    <string name="squeezer_markers_downscaled_description">Dette bildet er bredere eller høyere enn 8192 piksler. Komprimering halverer også oppløsningen.</string>

    <string name="squeezer_type_jpeg_title">JPEG</string>
    <string name="squeezer_type_jpeg_description">JPEG képek belefoglalása (.jpg, .jpeg). Az újrakódolás az Android beépített JPEG-kódolóját használja. A dátum, a helyadatok és az egyéb EXIF-metaadatok megmaradnak.</string>
    <string name="squeezer_type_webp_title">WebP</string>
    <string name="squeezer_type_webp_description">WebP képek belefoglalása (.webp). Az újrakódolás az Android beépített WebP-kódolóját használja. A dátum, a helyadatok és az egyéb EXIF-metaadatok megmaradnak.</string>
    <string name="squeezer_type_heic_title">HEIC/HEIF</string>
    <string name="squeezer_type_heic_description">Vegyen fel HEIC/HEIF képeket (.heic, .heif). A dátum, hely és egyéb EXIF metaadat megmaradnak. A HDR gain map-ek, mélységi adatok és élő/mozgó fotó kísérőfájlok nem őrizhetők meg; többképes fájlok kimaradnak.</string>
    <string name="squeezer_type_video_title">MP4 videó</string>
    <string name="squeezer_type_video_description">MP4 videofájlok belefoglalása (.mp4). A videosávot a készülék saját videokódolója alacsonyabb bitrátával kódolja újra, a hangsáv változatlanul átmásolódik, a fájl pedig MP4 marad.</string>
    <string name="squeezer_skip_compressed_title">Már tömörítettek kihagyása</string>
    <string name="squeezer_skip_compressed_description">Az SD Maid által már tömörített fájlok kihagyása.</string>
    <string name="squeezer_exif_marker_title">EXIF jelölő írása</string>
    <string name="squeezer_exif_marker_description">Jelölő hozzáadása a kép EXIF felhasználói megjegyzés mezőjéhez az újratömörítés megakadályozására még a tömörítési előzmények törlése után is.</string>
    <string name="squeezer_include_lossy_aux_title">HDR &amp; mélységi fotók tömörítése</string>
    <string name="squeezer_include_lossy_aux_description">HDR- vagy mélységadatokkal rendelkező fotók belefoglalása. A tömörítés eltávolítja ezeket: a HDR-fotókból normál fotók lesznek, a portréfotók elveszítik a háttérelmosáshoz használt adatokat. A több képet tartalmazó HEIC-fájlok továbbra is kimaradnak.</string>
    <string name="squeezer_include_motion_photos_title">Motion Photo fájlok tömörítése</string>
    <string name="squeezer_include_motion_photos_description">Motion Photo fájlok belefoglalása. A tömörítés megtartja az állóképet, és eltávolítja a videórészletet.</string>
    <string name="squeezer_include_oversized_title">Nagyon nagy fotók tömörítése</string>
    <string name="squeezer_include_oversized_description">A 8192 pixelnél szélesebb vagy magasabb fotók belefoglalása. A tömörítés a felbontásukat is felére csökkenti.</string>

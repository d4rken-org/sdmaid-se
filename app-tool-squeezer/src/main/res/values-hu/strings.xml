    <string name="squeezer_markers_dialog_title">Ezekről a jelölőkről</string>
    <string name="squeezer_markers_compressed_before_description">Az SD Maid már tömörítette ezt a fájlt. Az újbóli tömörítés minőségromlással jár, és csak keveset spórol.</string>
    <string name="squeezer_markers_hdr_depth_description">Ez a fotó HDR- vagy mélységadatokkal rendelkezik, amelyeket a tömörítés nem tud megtartani. Egy HDR-fotóból normál fotó lesz, egy portréfotó pedig elveszíti a háttérelmosáshoz használt mélységadatokat.</string>
    <string name="squeezer_markers_motion_photo_description">Ez egy Motion Photo. A tömörítés megtartja az állóképet, és eltávolítja a videórészletet.</string>
    <string name="squeezer_markers_downscaled_description">Ez a fotó szélesebb vagy magasabb 8192 pixelnél. A tömörítés a felbontását is felére csökkenti.</string>

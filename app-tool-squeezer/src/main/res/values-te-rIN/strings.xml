    <string name="squeezer_compression_settings_label">సాధారణ</string>
    <string name="squeezer_quality_description">తక్కువ నాణ్యత అంటే చిన్న ఫైల్ పరిమాణం కానీ తక్కువ దృశ్య నాణ్యత.</string>

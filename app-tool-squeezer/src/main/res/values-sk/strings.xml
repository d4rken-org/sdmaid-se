    <string name="squeezer_markers_dialog_title">O týchto značkách</string>
    <string name="squeezer_markers_compressed_before_description">SD Maid tento súbor už komprimoval. Opätovná kompresia zníži kvalitu a ušetrí len málo miesta.</string>
    <string name="squeezer_markers_hdr_depth_description">Táto fotografia obsahuje HDR alebo hĺbkové údaje, ktoré kompresia nedokáže zachovať. Z HDR fotografie sa stane bežná fotografia a portrétová fotografia príde o hĺbkové údaje použité na rozostrenie pozadia.</string>
    <string name="squeezer_markers_motion_photo_description">Toto je Motion Photo. Kompresia ponechá statický obrázok a odstráni video klip.</string>
    <string name="squeezer_markers_downscaled_description">Táto fotografia je širšia alebo vyššia ako 8192 pixelov. Kompresia zároveň zníži jej rozlíšenie na polovicu.</string>

    <string name="squeezer_type_jpeg_title">JPEG</string>
    <string name="squeezer_type_jpeg_description">Zahrnúť obrázky JPEG (.jpg, .jpeg). Prekódovanie využíva vstavaný kodér JPEG systému Android. Dátum, poloha a ostatné metadáta EXIF zostanú zachované.</string>
    <string name="squeezer_type_webp_title">WebP</string>
    <string name="squeezer_type_webp_description">Zahrnúť obrázky WebP (.webp). Prekódovanie využíva vstavaný kodér WebP systému Android. Dátum, poloha a ostatné metadáta EXIF zostanú zachované.</string>
    <string name="squeezer_type_heic_title">HEIC/HEIF</string>
    <string name="squeezer_type_heic_description">Vrátane obrázkov HEIC/HEIF (.heic, .heif). Dátum, poloha a ďalšie EXIF metadáta sú zachované. HDR mapy zisku, údaje o hĺbke a súbory Live/Motion Photo nemôžu byť zachované; súbory s viacerými obrázkami sú preskočené.</string>
    <string name="squeezer_type_video_title">MP4 Video</string>
    <string name="squeezer_type_video_description">Zahrnúť video súbory MP4 (.mp4). Video stopa sa prekóduje s nižším dátovým tokom pomocou vlastného video kodéra zariadenia, zvuková stopa sa skopíruje bez zmeny a súbor zostane vo formáte MP4.</string>
    <string name="squeezer_skip_compressed_title">Preskočiť predtým komprimované</string>
    <string name="squeezer_skip_compressed_description">Preskočiť súbory, ktoré už boli skomprimované aplikaciou SD Maid.</string>
    <string name="squeezer_exif_marker_title">Zapísať EXIF značku</string>
    <string name="squeezer_exif_marker_description">Pridať značku do poľa používateľského komentára EXIF obrázka, aby sa zabránilo opätovnej kompresii, aj keď sa história kompresie vymaže.</string>
    <string name="squeezer_include_lossy_aux_title">Komprimovať HDR &amp; fotografie s hĺbkou</string>
    <string name="squeezer_include_lossy_aux_description">Zahrnúť fotografie s HDR alebo hĺbkovými údajmi. Kompresia tieto údaje odstráni: z HDR fotografií sa stanú bežné fotografie a portrétové fotografie prídu o údaje, z ktorých sa vytvára rozostrenie pozadia. Viacobrázkové súbory HEIC zostanú naďalej preskočené.</string>
    <string name="squeezer_include_motion_photos_title">Komprimovať Motion Photos</string>
    <string name="squeezer_include_motion_photos_description">Zahrnúť Motion Photos. Kompresia ponechá statický obrázok a odstráni video klip.</string>
    <string name="squeezer_include_oversized_title">Komprimovať veľmi veľké fotografie</string>
    <string name="squeezer_include_oversized_description">Zahrnúť fotografie širšie alebo vyššie ako 8192 pixelov. Kompresia zároveň zníži ich rozlíšenie na polovicu.</string>

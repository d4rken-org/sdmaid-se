    <string name="squeezer_type_jpeg_title">JPEG</string>
    <string name="squeezer_type_jpeg_description">包含JPEG图像(.jpg、.jpeg)。重新编码使用Android内置的JPEG编码器。保留日期、位置和其他EXIF元数据。</string>
    <string name="squeezer_type_webp_title">WebP</string>
    <string name="squeezer_type_webp_description">包含WebP图像(.webp)。重新编码使用Android内置的WebP编码器。保留日期、位置和其他EXIF元数据。</string>
    <string name="squeezer_type_heic_title">HEIC/HEIF</string>
    <string name="squeezer_type_heic_description">包括 HEIC/HEIF 图像（.heic、.heif）。日期、位置和其他 EXIF 元数据将被保留。HDR 增益贴图、深度数据和 Live/Motion Photo 兄弟文件无法保留；多图像文件将被跳过。</string>
    <string name="squeezer_type_video_title">MP4 视频</string>
    <string name="squeezer_type_video_description">包含MP4视频文件(.mp4)。视频轨道由设备的视频编码器以较低比特率重新编码，音频轨道原样复制，文件保持为MP4格式。</string>
    <string name="squeezer_skip_compressed_title">跳过已压缩的图片</string>
    <string name="squeezer_skip_compressed_description">跳过已被 SD Maid 压缩的文件。</string>
    <string name="squeezer_exif_marker_title">写入 EXIF 标记</string>
    <string name="squeezer_exif_marker_description">在图片的 EXIF 用户备注字段中添加标记，以防止即使压缩记录被清除也不会重新压缩。</string>
    <string name="squeezer_include_lossy_aux_title">压缩 HDR&amp;深度照片</string>
    <string name="squeezer_include_lossy_aux_description">包含HDR或深度数据的照片。压缩会删除该数据：HDR照片变为普通照片，人像照片会丢失用于背景模糊的深度数据。多张图像HEIC文件仍被跳过。</string>
    <string name="squeezer_include_motion_photos_title">压缩动态照片</string>
    <string name="squeezer_include_motion_photos_description">包含动态照片。压缩保留静止图像并删除视频片段。</string>
    <string name="squeezer_include_oversized_title">压缩超大照片</string>
    <string name="squeezer_include_oversized_description">包含宽度或高度超过8192像素的照片。压缩还会将其分辨率减半。</string>

    <string name="squeezer_quality_hint_very_low" formatted="false">质量低于 40% 可能会产生无法使用的图片。</string>
    <string name="squeezer_quality_hint_low">较低的质量可节省更多空间，但可能会产生明显的伪影。</string>
    <string name="squeezer_quality_hint_high">非常高的质量只能节省极少空间。</string>
    <string name="squeezer_quality_hint_normal">质量与空间节省之间的平衡。</string>

    <string name="squeezer_type_jpeg_title">JPEG</string>
    <string name="squeezer_type_jpeg_description">Kaasa arvatud JPEG-pildid (.jpg, .jpeg). Uuesti kodeerimiseks kasutatakse Androidi sisseehitatud JPEG-kodeerijat. Kuupäev, asukoht ja muud EXIF-metaandmed säilitatakse.</string>
    <string name="squeezer_type_webp_title">WebP</string>
    <string name="squeezer_type_webp_description">Kaasa arvatud WebP-pildid (.webp). Uuesti kodeerimiseks kasutatakse Androidi sisseehitatud WebP-kodeerijat. Kuupäev, asukoht ja muud EXIF-metaandmed säilitatakse.</string>
    <string name="squeezer_type_heic_title">HEIC/HEIF</string>
    <string name="squeezer_type_heic_description">Kaasa HEIC/HEIF pildid (.heic, .heif). Kuupäev, asukoht ja muud EXIF-i metaandmed jäetakse alles. HDR võimenduse kaarte, sügavuse andmeid ja Live/Motion Photo siduseid ei saa säilitada; mitme pildiga failid jäetakse vahele.</string>
    <string name="squeezer_type_video_title">MP4 Video</string>
    <string name="squeezer_type_video_description">Kaasa arvatud MP4-videofailid (.mp4). Videojälge kodeeritakse uuesti madalama bittidkiirusega seadme enda videokodeerija abil, audiojälge kopeeritakse muutumatult üle ja fail jääb MP4ks.</string>
    <string name="squeezer_skip_compressed_title">Eira varem kokkupakitut</string>
    <string name="squeezer_skip_compressed_description">Eira SD Maidi juba kokkupakitud failid.</string>
    <string name="squeezer_exif_marker_title">Kirjuta EXIF märkus</string>
    <string name="squeezer_exif_marker_description">Tee märge pildi EXIFi kasutaja kommentaari väljale, et ennetada uuesti kokkupakkimist isegi pärast kokkupakkimise ajaloo tühjenemist.</string>
    <string name="squeezer_include_lossy_aux_title">Tihenda HDR &amp; sügavusfotod</string>
    <string name="squeezer_include_lossy_aux_description">Kaasa arvatud HDR- või sügavuse andmetega fotod. Tihendamine eemaldab need: HDR-fotod muutuvad tavaliseks fotodeks, portreefotod kaotavad tausta häguse taga olevad andmed. Mitmepildilised HEIC-failid jäävad vahele.</string>
    <string name="squeezer_include_motion_photos_title">Tihenda Motion Photod</string>
    <string name="squeezer_include_motion_photos_description">Kaasa arvatud Motion Photod. Tihendamine säilitab seisva pildi ja eemaldab videoklipi.</string>
    <string name="squeezer_include_oversized_title">Tihenda väga suured fotod</string>
    <string name="squeezer_include_oversized_description">Kaasa arvatud fotod, mis on laiemad või pikemad kui 8192 pikslit. Tihendamine poolitab ka nende eraldusvõime.</string>

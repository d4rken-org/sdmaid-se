    <string name="squeezer_video_settings_category_label">Nastavení videa</string>
    <string name="squeezer_type_jpeg_title">JPEG</string>
    <string name="squeezer_type_jpeg_description">Zahrnout obrázky JPEG (.jpg, .jpeg). Kódování znovu používá vestavěný kodér JPEG Androidu. Datum, umístění a ostatní metadata EXIF jsou zachována.</string>
    <string name="squeezer_type_webp_title">WebP</string>
    <string name="squeezer_type_webp_description">Zahrnout obrázky WebP (.webp). Kódování znovu používá vestavěný kodér WebP Androidu. Datum, umístění a ostatní metadata EXIF jsou zachována.</string>
    <string name="squeezer_type_heic_title">HEIC/HEIF</string>
    <string name="squeezer_type_heic_description">Zahrnout HEIC/HEIF obrázky (.heic, .heif). Datum, poloha a další EXIF metadata se zachovávají. Mapy zisků HDR, údaje o hloubce a živé/pohyblivé fotky nelze zachovat; soubory s více obrázky se přeskočí.</string>
    <string name="squeezer_type_video_title">Video MP4</string>
    <string name="squeezer_type_video_description">Zahrnout videa MP4 (.mp4). Video je překódováno na nižší datový tok pomocí vlastního kodéru zařízení, zvuk zůstane nezměněn a soubor zůstane v MP4.</string>
    <string name="squeezer_skip_compressed_title">Přeskočit dříve zkomprimované</string>
    <string name="squeezer_skip_compressed_description">Přeskočit soubory, které již byly komprimovány SD Maid.</string>
    <string name="squeezer_exif_marker_title">Vložit EXIF značku</string>
    <string name="squeezer_exif_marker_description">Připojí značku do pole komentáře v EXIF obrázku, aby se zamezilo rekompresi v případě vyčištění historie kompresí.</string>
    <string name="squeezer_include_lossy_aux_title">Komprimovat HDR &amp; hloubkové fotografie</string>
    <string name="squeezer_include_lossy_aux_description">Zahrnout fotografie s HDR nebo informacemi o hloubce. Komprese je odstraní: fotografie HDR se změní na běžné fotografie, portrétní fotografie ztratí data sloužící k rozostření pozadí. Vícesnímkové soubory HEIC jsou nadále přeskočeny.</string>
    <string name="squeezer_include_motion_photos_title">Komprimovat Snímky s pohybem</string>
    <string name="squeezer_include_motion_photos_description">Zahrnout Snímky s pohybem. Komprese zachová statický snímek a odebere videoklip.</string>
    <string name="squeezer_include_oversized_title">Komprimovat velmi velké fotografie</string>
    <string name="squeezer_include_oversized_description">Zahrnout fotografie širší nebo vyšší než 8192 pixelů. Komprese také rozpůlí jejich rozlišení.</string>

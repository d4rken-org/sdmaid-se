    <string name="squeezer_type_jpeg_title">JPEG</string>
    <string name="squeezer_type_jpeg_description">JPEG şəkillərini (.jpg, .jpeg) daxil et. Yenidən kodlaşdırma Android-in daxili JPEG kodlaşdırıcısından istifadə edir. Tarix, məkan və digər EXIF metadatası saxlanılır.</string>
    <string name="squeezer_type_webp_title">WebP</string>
    <string name="squeezer_type_webp_description">WebP şəkillərini (.webp) daxil et. Yenidən kodlaşdırma Android-in daxili WebP kodlaşdırıcısından istifadə edir. Tarix, məkan və digər EXIF metadatası saxlanılır.</string>
    <string name="squeezer_type_heic_title">HEIC/HEIF</string>
    <string name="squeezer_type_heic_description">HEIC/HEIF şəkilləri (.heic, .heif) daxil edin. Tarix, yerlər və digər EXIF metaadatları saxlanılır. HDR qazanc xəritələri, dərinlik məlumatları və Live/Motion Photo qardaşları qorunmur; çox şəkilli fayllar atlanır.</string>
    <string name="squeezer_type_video_title">MP4 Video</string>
    <string name="squeezer_type_video_description">MP4 video fayllarını (.mp4) daxil et. Video treki cihazın öz video kodlaşdırıcısı tərəfindən daha aşağı bitreytdə yenidən kodlaşdırılır, audio treki dəyişmədən köçürülür və fayl MP4 formatında qalır.</string>
    <string name="squeezer_skip_compressed_title">Əvvəl sıxışdırılmışları keç</string>
    <string name="squeezer_skip_compressed_description">SD Maid tərəfindən artıq sıxışdırılmış faylları atlayın.</string>
    <string name="squeezer_exif_marker_title">EXIF işarəsi yaz</string>
    <string name="squeezer_exif_marker_description">Sıxışdırma tarixçəsi silinsa belə təkrar sıxışdırmanın qarşısını almaq üçün şəklin EXIF istifadəçi şərhi sahəsinə işarə əlavə edin.</string>
    <string name="squeezer_include_lossy_aux_title">HDR &amp; dərinlik fotoları sıxlaşdır</string>
    <string name="squeezer_include_lossy_aux_description">HDR və ya dərinlik məlumatı olan fotoları daxil et. Sıxma bu məlumatı silir: HDR fotolar adi fotolara çevrilir, portret fotolar isə arxa fon bulanıqlığı üçün istifadə olunan dərinlik məlumatını itirir. Çox şəkilli HEIC faylları atlanmağa davam edir.</string>
    <string name="squeezer_include_motion_photos_title">Motion Photo-ları sıxışdır</string>
    <string name="squeezer_include_motion_photos_description">Motion Photo-ları daxil et. Sıxma sabit şəkli saxlayır və video klipi silir.</string>
    <string name="squeezer_include_oversized_title">Çox böyük fotoları sıxışdır</string>
    <string name="squeezer_include_oversized_description">8192 pikseldən enli və ya hündür fotoları daxil et. Sıxma həmçinin onların ayırdetmə qabiliyyətini yarıya endirir.</string>

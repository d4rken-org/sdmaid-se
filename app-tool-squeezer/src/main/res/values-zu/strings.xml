    <string name="squeezer_type_jpeg_title">JPEG</string>
    <string name="squeezer_type_jpeg_description">Faka izithombe ze-JPEG (.jpg, .jpeg). I-re-encoding isebenzisa i-encoder ye-JPEG ene-Android enekwe. Usuku, indawo, nezinye imininingwane ye-EXIF igcinwa.</string>
    <string name="squeezer_type_webp_title">WebP</string>
    <string name="squeezer_type_webp_description">Faka izithombe ze-WebP (.webp). I-re-encoding isebenzisa i-encoder ye-WebP ene-Android enekwe. Usuku, indawo, nezinye imininingwane ye-EXIF igcinwa.</string>
    <string name="squeezer_type_heic_title">HEIC/HEIF</string>
    <string name="squeezer_type_heic_description">Ibalisa izithombe ze-HEIC/HEIF (.heic, .heif). Usuku, indawo, nezinye i-metadata ye-EXIF igcinwe. I-HDR gain map, idatha yolunzima, kanye ne-Live/Motion Photo ezinombandlulwane azikwazi ukugcinwa; amafayili anemifanekiso eminingi ayaliwe.</string>
    <string name="squeezer_type_video_title">MP4 Video</string>
    <string name="squeezer_type_video_description">Faka amafayela avidiyo e-MP4 (.mp4). Iyithi yevidiyo ifaka kabusha nge-bitrate elincane yi-encoder yevidiyo yomshini, iyithi yezwi ikopwe phezu ephuye njengeyakuqala, futhi ifayela lihlala liyi-MP4.</string>
    <string name="squeezer_skip_compressed_title">Yeqa ezicindezelwe ngaphambilini</string>
    <string name="squeezer_skip_compressed_description">Yeqa amafayela asevele egoqiwe ngu-SD Maid.</string>
    <string name="squeezer_exif_marker_title">Bhala uphawu lwe-EXIF</string>
    <string name="squeezer_exif_marker_description">Engeza uphawu enkundleni yokuphawula komsebenzisi we-EXIF yesithombe ukuvimbela ukucindezelwa kabusha noma umlando wokucindezela usulwe.</string>
    <string name="squeezer_include_lossy_aux_title">Cinza izithombe ze-HDR &amp; depth</string>
    <string name="squeezer_include_lossy_aux_description">Faka izithombe ezine-HDR noma idatha yejuba. Isikweliso sisuluza: izithombe ze-HDR ziba yizithombe ezijwayelekile, izithombe zomfanekiso ziphulukane idatha engemuva kokubhida kwengqondo yomhlaba. Amafayela e-HEIC anezithombe eziningi aqhubeka liphuthelwe.</string>
    <string name="squeezer_include_motion_photos_title">Kwelisa izithombe ze-Motion</string>
    <string name="squeezer_include_motion_photos_description">Faka izithombe ze-Motion. Isikweliso sugcina isithombe esimileyo futhi sisuluza ulwimi lovidiyo.</string>
    <string name="squeezer_include_oversized_title">Kwelisa izithombe ezikhulu kakhulu</string>
    <string name="squeezer_include_oversized_description">Faka izithombe ezibanzi noma eziphakeme kunezinso 8192. Isikweliso nakho kwahlasela isigexe sokubonakalisa.</string>

    <string name="squeezer_type_jpeg_title">JPEG</string>
    <string name="squeezer_type_jpeg_description">Iekļaut JPEG attēlus (.jpg, .jpeg). Pārkodēšanai tiek izmantots Android iebūvētais JPEG kodētājs. Datums, atrašanās vieta un citi EXIF metadati tiek saglabāti.</string>
    <string name="squeezer_type_webp_title">WebP</string>
    <string name="squeezer_type_webp_description">Iekļaut WebP attēlus (.webp). Pārkodēšanai tiek izmantots Android iebūvētais WebP kodētājs. Datums, atrašanās vieta un citi EXIF metadati tiek saglabāti.</string>
    <string name="squeezer_type_heic_title">HEIC/HEIF</string>
    <string name="squeezer_type_heic_description">Iekļaut HEIC/HEIF attēlus (.heic, .heif). Datums, atrašanās vieta un citi EXIF metadati tiek saglabāti. HDR pastiprinājuma kartes, dziļuma dati un Live/Motion Photo pāri nevar tikt saglabāti; vairāku attēlu faili tiek izlaisti.</string>
    <string name="squeezer_type_video_title">MP4 Video</string>
    <string name="squeezer_type_video_description">Iekļaut MP4 video failus (.mp4). Video celiņu ar zemāku bitreitu pārkodē ierīces paša video kodētājs, audio celiņš tiek kopēts nemainīts, un fails paliek MP4 formātā.</string>
    <string name="squeezer_skip_compressed_title">Izlaist jau saspiestus</string>
    <string name="squeezer_skip_compressed_description">Izlaist failus, kas jau ir saspiesti ar SD Maid.</string>
    <string name="squeezer_exif_marker_title">Rakstīt EXIF atzīmi</string>
    <string name="squeezer_exif_marker_description">Pievienot atzīmi attēla EXIF lietotāja komentāra laukam, lai novērstu atkartotu saspiešanu, pat ja kompresijas vēsture ir notīrīta.</string>
    <string name="squeezer_include_lossy_aux_title">Saspiest HDR un dziļuma fotogrāfijas</string>
    <string name="squeezer_include_lossy_aux_description">Iekļaut fotoattēlus ar HDR vai dziļuma datiem. Saspiešana tos noņem: HDR fotoattēli kļūst par parastiem fotoattēliem, bet portreta fotoattēli zaudē datus, kas nepieciešami fona izplūduma efektam. Vairāku attēlu HEIC faili joprojām tiek izlaisti.</string>
    <string name="squeezer_include_motion_photos_title">Saspiest Motion Photo attēlus</string>
    <string name="squeezer_include_motion_photos_description">Iekļaut Motion Photo attēlus. Saspiešana saglabā nekustīgo attēlu un noņem video klipu.</string>
    <string name="squeezer_include_oversized_title">Saspiest ļoti lielus fotoattēlus</string>
    <string name="squeezer_include_oversized_description">Iekļaut fotoattēlus, kas platāki vai augstāki par 8192 pikseļiem. Saspiešana arī samazina to izšķirtspēju uz pusi.</string>

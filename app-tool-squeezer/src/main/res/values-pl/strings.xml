    <string name="squeezer_quality_hint_very_low" formatted="false">Jakość poniżej 40% może tworzyć niezdatne do użytku obrazy.</string>
    <string name="squeezer_quality_hint_low">Niższa jakość pozwala zaoszczędzić więcej miejsca, ale może powodować widoczne artefakty.</string>
    <string name="squeezer_quality_hint_high">Bardzo wysoka jakość zapewnia minimalne oszczędności przestrzeni.</string>
    <string name="squeezer_quality_hint_normal">Zrównoważona jakość i oszczędność miejsca.</string>

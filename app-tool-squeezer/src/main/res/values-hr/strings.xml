    <string name="squeezer_type_jpeg_title">JPEG</string>
    <string name="squeezer_type_jpeg_description">Uključuje JPEG slike (.jpg, .jpeg). Ponovno kodiranje koristi ugrađeni JPEG koder sustava Android. Datum, lokacija i ostali EXIF metapodaci se zadržavaju.</string>
    <string name="squeezer_type_webp_title">WebP</string>
    <string name="squeezer_type_webp_description">Uključuje WebP slike (.webp). Ponovno kodiranje koristi ugrađeni WebP koder sustava Android. Datum, lokacija i ostali EXIF metapodaci se zadržavaju.</string>
    <string name="squeezer_type_heic_title">HEIC/HEIF</string>
    <string name="squeezer_type_heic_description">Uključi HEIC/HEIF slike (.heic, .heif). Datum, lokacija i ostali EXIF metapodaci se čuvaju. HDR mape, dubinski podaci i Live/Motion Photo dodatne slike ne mogu biti sačuvani; datoteke s više slika se preskaču.</string>
    <string name="squeezer_type_video_title">MP4 videozapis</string>
    <string name="squeezer_type_video_description">Uključuje MP4 videodatoteke (.mp4). Videozapis se ponovno kodira s nižom brzinom prijenosa pomoću ugrađenog video kodera uređaja, audiozapis se kopira nepromijenjen, a datoteka ostaje MP4.</string>
    <string name="squeezer_skip_compressed_title">Preskoči prethodno komprimirane</string>
    <string name="squeezer_skip_compressed_description">Preskoči datoteke koje je SD Maid već komprimirao.</string>
    <string name="squeezer_exif_marker_title">Zapiši EXIF marker</string>
    <string name="squeezer_exif_marker_description">Dodaj marker u polje komentara korisnika EXIF slike kako bi se spriječila ponovna kompresija čak i ako se povijest kompresije obriše.</string>
    <string name="squeezer_include_lossy_aux_title">Komprimiraj HDR i dubinske fotografije</string>
    <string name="squeezer_include_lossy_aux_description">Uključuje fotografije s HDR-om ili podacima o dubini. Sažimanje ih uklanja: HDR fotografije postaju obične fotografije, a portretne fotografije gube podatke na kojima se temelji zamućenje pozadine. Višeslikovne HEIC datoteke ostaju preskočene.</string>
    <string name="squeezer_include_motion_photos_title">Sažmi pokretne fotografije</string>
    <string name="squeezer_include_motion_photos_description">Uključuje pokretne fotografije. Sažimanje zadržava fotografiju, a uklanja videozapis.</string>
    <string name="squeezer_include_oversized_title">Sažmi vrlo velike fotografije</string>
    <string name="squeezer_include_oversized_description">Uključuje fotografije šire ili više od 8192 piksela. Sažimanje im također prepolovi rezoluciju.</string>

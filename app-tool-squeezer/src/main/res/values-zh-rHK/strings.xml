    <string name="squeezer_min_size_title">最小檔案大小</string>
    <string name="squeezer_min_size_description">跳過小於此大小的檔案。</string>
    <string name="squeezer_min_age_title">最小檔案年齡</string>
    <string name="squeezer_min_age_description">僅包含早於此年齡的檔案。</string>
    <string name="squeezer_compression_settings_label">一般</string>
    <string name="squeezer_quality_description">較低畫質意味著較小的檔案大小，但視覺品質降低。</string>
    <string name="squeezer_types_category_label">圖片設定</string>
    <string name="squeezer_protected_category_label">會流失的內容</string>
    <string name="squeezer_video_settings_category_label">影片設定</string>
    <string name="squeezer_type_jpeg_title">JPEG</string>
    <string name="squeezer_type_jpeg_description">包含 JPEG 圖片（.jpg、.jpeg）。重新編碼使用 Android 內建的 JPEG 編碼器。日期、位置及其他 EXIF 中繼資料會予以保留。</string>
    <string name="squeezer_type_webp_title">WebP</string>
    <string name="squeezer_type_webp_description">包含 WebP 圖片（.webp）。重新編碼使用 Android 內建的 WebP 編碼器。日期、位置及其他 EXIF 中繼資料會予以保留。</string>
    <string name="squeezer_type_heic_title">HEIC/HEIF</string>
    <string name="squeezer_type_heic_description">包含 HEIC/HEIF 影像 (.heic, .heif)。日期、位置及其他 EXIF 中繼資料會保留。HDR 增益對應、深度資料和 Live/Motion Photo 相關檔案無法保留；多重影像檔案會略過。</string>
    <string name="squeezer_type_video_title">MP4 影片</string>
    <string name="squeezer_type_video_description">包含 MP4 影片檔案（.mp4）。影片軌會由裝置本身的影片編碼器以較低的位元率重新編碼，音訊軌會原封不動地複製過去，檔案仍會是 MP4 格式。</string>
    <string name="squeezer_skip_compressed_title">略過已壓縮的檔案</string>
    <string name="squeezer_skip_compressed_description">跳過已由 SD Maid 壓縮過的檔案。</string>
    <string name="squeezer_exif_marker_title">寫入 EXIF 標記</string>
    <string name="squeezer_exif_marker_description">在圖片的 EXIF 使用者評論欄位附加標記，以防止再次壓縮，即使壓縮歷史記錄被清除。</string>
    <string name="squeezer_include_lossy_aux_title">壓縮 HDR 和深度相片</string>
    <string name="squeezer_include_lossy_aux_description">包含具有 HDR 或深度資料的相片。壓縮會移除這些資料：HDR 相片會變成一般相片，人像相片則會失去用於背景模糊效果的資料。多重影像的 HEIC 檔案仍會被略過。</string>
    <string name="squeezer_include_motion_photos_title">壓縮動態相片</string>
    <string name="squeezer_include_motion_photos_description">包含動態相片。壓縮會保留靜態影像並移除影片片段。</string>
    <string name="squeezer_include_oversized_title">壓縮超大相片</string>
    <string name="squeezer_include_oversized_description">包含寬度或高度超過 8192 像素的相片。壓縮亦會將其解像度減半。</string>
    <string name="squeezer_estimated_savings_format">預計節省約 %s</string>
    <string name="squeezer_no_savings_expected">有限的節省</string>
    <string name="squeezer_current_size_format">大小：%s</string>
    <string name="squeezer_chip_compressed_before">已壓縮</string>
    <string name="squeezer_chip_hdr_depth">HDR/深度</string>
    <string name="squeezer_chip_motion_photo">動態相片</string>
    <string name="squeezer_chip_downscaled">已縮小</string>
    <string name="squeezer_markers_dialog_title">關於這些標記</string>
    <string name="squeezer_markers_compressed_before_description">SD Maid 已經壓縮過這個檔案。再次壓縮只會犧牲畫質，節省的空間卻很少。</string>
    <string name="squeezer_markers_hdr_depth_description">這張相片具有壓縮無法保留的 HDR 或深度資料。HDR 相片會變回一般相片，人像相片則會失去用於背景模糊效果的深度資料。</string>
    <string name="squeezer_markers_motion_photo_description">這是一張動態相片。壓縮會保留靜態影像並移除影片片段。</string>
    <string name="squeezer_markers_downscaled_description">這張相片的寬度或高度超過 8192 像素。壓縮亦會將其解像度減半。</string>

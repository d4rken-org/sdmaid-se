    <string name="squeezer_type_jpeg_title">JPEG</string>
    <string name="squeezer_type_jpeg_description">Įtraukti JPEG nuotraukas (.jpg, .jpeg). Iš naujo koduojant naudojamas Android įmontuotas JPEG kodavimas. Data, vieta ir kiti EXIF metaduomenys yra išsaugomi.</string>
    <string name="squeezer_type_webp_title">WebP</string>
    <string name="squeezer_type_webp_description">Įtraukti WebP nuotraukas (.webp). Iš naujo koduojant naudojamas Android įmontuotas WebP kodavimas. Data, vieta ir kiti EXIF metaduomenys yra išsaugomi.</string>
    <string name="squeezer_type_heic_title">HEIC/HEIF</string>
    <string name="squeezer_type_heic_description">Įtraukti HEIC/HEIF vaizdinius (.heic, .heif). Data, vieta ir kiti EXIF metaduomenys yra išsaugoti. HDR pelno žemėlapiai, gylio duomenys ir „Live“/„Motion Photo“ šeimos negali būti išsaugoti; kelių vaizdinių failai praleisti.</string>
    <string name="squeezer_type_video_title">MP4 Video</string>
    <string name="squeezer_type_video_description">Įtraukti MP4 vaizdo failus (.mp4). Vaizdo takelis iš naujo koduojamas mažesniu bitrate naudojant įrenginio savąjį vaizdo kodavimą, garso takelis kopijuojamas nepakitęs, o failas lieka MP4.</string>
    <string name="squeezer_skip_compressed_title">Praleisti anksčiau suglaudintus</string>
    <string name="squeezer_skip_compressed_description">Praleisti failus, kurie jau buvo suglaudinti SD Maid.</string>
    <string name="squeezer_exif_marker_title">Rašyti EXIF žymė</string>
    <string name="squeezer_exif_marker_description">Prideti žymę prie vaizdo EXIF vartotojo komentaro lauko, kad būtų užkirstas kelias pakartotiniam suglaudinimui net jei suglaudinimo istorija išvaloma.</string>
    <string name="squeezer_include_lossy_aux_title">Suglaudinti HDR ir gylio nuotraukas</string>
    <string name="squeezer_include_lossy_aux_description">Įtraukti nuotraukas su HDR arba gylio duomenimis. Suspaudimas juos pašalina: HDR nuotraukos tampa paprastomis, portreto nuotraukos praranda gylio duomenis. Iš kelių vaizdų sudaryti HEIC failai lieka praleisti.</string>
    <string name="squeezer_include_motion_photos_title">Suspausti judančias nuotraukas</string>
    <string name="squeezer_include_motion_photos_description">Įtraukti judančias nuotraukas. Suspaudimas išlaiko nejudantį vaizdą ir pašalina vaizdo klipą.</string>
    <string name="squeezer_include_oversized_title">Suspausti labai dideles nuotraukas</string>
    <string name="squeezer_include_oversized_description">Įtraukti nuotraukas, kurios yra plačesnės arba aukštesnės nei 8192 pikseliai. Suspaudimas taip pat sumažina jų skyrą per pusę.</string>

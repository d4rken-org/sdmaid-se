    <string name="squeezer_markers_dialog_title">Um þessi merki</string>
    <string name="squeezer_markers_compressed_before_description">SD Maid hefur þegar þjappað þessari skrá. Að þjappa henni aftur kostar gæði og sparar lítið.</string>
    <string name="squeezer_markers_hdr_depth_description">Þessi mynd hefur HDR- eða dýptargögn sem þjöppun getur ekki varðveitt. HDR-mynd verður að venjulegri mynd og andlitsmynd missir dýptargögnin sem notuð eru fyrir óskýrleika bakgrunns.</string>
    <string name="squeezer_markers_motion_photo_description">Þetta er Motion Photo. Þjöppun heldur kyrrmyndinni og fjarlægir myndskeiðið.</string>
    <string name="squeezer_markers_downscaled_description">Þessi mynd er breiðari eða hærri en 8192 dílar. Þjöppun helmingar einnig upplausn hennar.</string>

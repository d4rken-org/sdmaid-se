    <string name="squeezer_video_settings_category_label">Myndbandasstillingar</string>
    <string name="squeezer_type_jpeg_title">JPEG</string>
    <string name="squeezer_type_jpeg_description">Taka með JPEG-myndir (.jpg, .jpeg). Endurkóðun notar innbyggða JPEG-kóðara Android. Dagsetning, staðsetning og önnur EXIF-lýsigögn eru varðveitt.</string>
    <string name="squeezer_type_webp_title">WebP</string>
    <string name="squeezer_type_webp_description">Taka með WebP-myndir (.webp). Endurkóðun notar innbyggða WebP-kóðara Android. Dagsetning, staðsetning og önnur EXIF-lýsigögn eru varðveitt.</string>
    <string name="squeezer_type_heic_title">HEIC/HEIF</string>
    <string name="squeezer_type_heic_description">Taka með HEIC/HEIF myndum (.heic, .heif). Dagsetning, staðsetning og önnur EXIF gögn eru varðveitt. HDR gain maps, dýptargögn og Live/Motion Photo systkin geta ekki verið varðveitt; skrár með mörgum myndum eru sleppar.</string>
    <string name="squeezer_type_video_title">MP4 myndband</string>
    <string name="squeezer_type_video_description">Taka með MP4-myndskeið (.mp4). Myndbandsrásin er endurkóðuð með lægri bitahraða af eigin myndbandskóðara tækisins, hljóðrásin er afrituð óbreytt og skráin er áfram MP4.</string>
    <string name="squeezer_skip_compressed_title">Sleppa áður þjöppuðum</string>
    <string name="squeezer_skip_compressed_description">Sleppa skrám sem þgar hafa verið þjappaðar af SD Maid.</string>
    <string name="squeezer_exif_marker_title">Skrifa EXIF merki</string>
    <string name="squeezer_exif_marker_description">Bæta merki við EXIF athugasemdareit myndarinnar til að koma í veg fyrir endurþjöppun jafnvel þótt þjöppunarsaga sé hreinsuð.</string>
    <string name="squeezer_include_lossy_aux_title">Þjaúpa HDR &amp; dýptarmyndum</string>
    <string name="squeezer_include_lossy_aux_description">Taka með myndir með HDR- eða dýptargögnum. Þjöppun fjarlægir þau: HDR-myndir verða venjulegar myndir og andlitsmyndir missa gögnin á bak við óskýrleika bakgrunnsins. HEIC-skrám með mörgum myndum er áfram sleppt.</string>
    <string name="squeezer_include_motion_photos_title">Þjappa Motion Photos</string>
    <string name="squeezer_include_motion_photos_description">Taka með Motion Photos. Þjöppun heldur kyrrmyndinni og fjarlægir myndskeiðið.</string>
    <string name="squeezer_include_oversized_title">Þjappa mjög stórum myndum</string>
    <string name="squeezer_include_oversized_description">Taka með myndir sem eru breiðari eða hærri en 8192 dílar. Þjöppun helmingar einnig upplausn þeirra.</string>
    <string name="squeezer_estimated_savings_format">~%s sparnaður</string>
    <string name="squeezer_no_savings_expected">Takmarkaður sparnaður</string>

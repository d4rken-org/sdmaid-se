    <string name="squeezer_type_jpeg_title">JPEG</string>
    <string name="squeezer_type_jpeg_description">მოიცავს JPEG სურათებს (.jpg, .jpeg). ხელახალი კოდირებისთვის გამოიყენება Android-ის ჩაშენებული JPEG კოდერი. თარიღი, მდებარეობა და სხვა EXIF მეტამონაცემები შენარჩუნებულია.</string>
    <string name="squeezer_type_webp_title">WebP</string>
    <string name="squeezer_type_webp_description">მოიცავს WebP სურათებს (.webp). ხელახალი კოდირებისთვის გამოიყენება Android-ის ჩაშენებული WebP კოდერი. თარიღი, მდებარეობა და სხვა EXIF მეტამონაცემები შენარჩუნებულია.</string>
    <string name="squeezer_type_heic_title">HEIC/HEIF</string>
    <string name="squeezer_type_heic_description">მოიცავს HEIC/HEIF სურათებს (.heic, .heif). თარიღი, ადგილმდებარეობა და სხვა EXIF მეტამონაცემი შენარჩუნებულია. HDR gain maps, depth data და Live/Motion Photo ფაილები ვერ შეიძლება შენარჩუნდეს; მრავალ-გამოსახულებიანი ფაილები გამოტოვებულია.</string>
    <string name="squeezer_type_video_title">MP4 ვიდეო</string>
    <string name="squeezer_type_video_description">მოიცავს MP4 ვიდეო ფაილებს (.mp4). ვიდეო ტრეკი ხელახლა კოდირდება დაბალი ბიტრეიტით მოწყობილობის საკუთარი ვიდეო კოდერის მეშვეობით, აუდიო ტრეკი უცვლელად კოპირდება, ხოლო ფაილი რჩება MP4 ფორმატში.</string>
    <string name="squeezer_skip_compressed_title">ადრე შეკუმშულების გამოტოვება</string>
    <string name="squeezer_skip_compressed_description">გამოტოვე ფაილები, რომლებიც უკვე შეკუმშულია SD Maid-ის მიერ.</string>
    <string name="squeezer_exif_marker_title">EXIF მარკერის ჩაწერა</string>
    <string name="squeezer_exif_marker_description">სურათის EXIF მომხმარებლის კომენტარის ველში მარკერის დამატება ხელახალი შეკუმშვის თავიდან ასაცილებლად, მაშინაც კი, თუ შეკუმშვის ისტორია გასუფთავდა.</string>
    <string name="squeezer_include_lossy_aux_title">HDR &amp; სიღრმის ფოტოების შეკუმშვა</string>
    <string name="squeezer_include_lossy_aux_description">მოიცავს ფოტოებს HDR ან სიღრმის მონაცემებით. შეკუმშვა შლის მათ: HDR ფოტოები ჩვეულებრივ ფოტოებად იქცევა, ხოლო პორტრეტული ფოტოები კარგავენ ფონის დაბინდვისთვის საჭირო მონაცემებს. მრავალსურათიანი HEIC ფაილები კვლავ გამოტოვებული რჩება.</string>
    <string name="squeezer_include_motion_photos_title">Motion Photo-ების შეკუმშვა</string>
    <string name="squeezer_include_motion_photos_description">მოიცავს Motion Photo-ებს. შეკუმშვა ინარჩუნებს უძრავ სურათს და შლის ვიდეო კლიპს.</string>
    <string name="squeezer_include_oversized_title">ძალიან დიდი ფოტოების შეკუმშვა</string>
    <string name="squeezer_include_oversized_description">მოიცავს ფოტოებს, რომლებიც სიგანით ან სიმაღლით 8192 პიქსელს აღემატება. შეკუმშვა ასევე ორჯერ ამცირებს მათ გარჩევადობას.</string>

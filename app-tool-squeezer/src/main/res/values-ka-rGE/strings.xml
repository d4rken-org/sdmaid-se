    <string name="squeezer_markers_hdr_depth_description">ამ ფოტოს აქვს HDR ან სიღრმის მონაცემები, რომლის შენარჩუნებაც შეკუმშვას არ შეუძლია. HDR ფოტო ჩვეულებრივ ფოტოდ იქცევა, ხოლო პორტრეტული ფოტო კარგავს ფონის დაბინდვისთვის საჭირო სიღრმის მონაცემებს.</string>
    <string name="squeezer_markers_motion_photo_description">ეს არის Motion Photo. შეკუმშვა ინარჩუნებს უძრავ სურათს და შლის ვიდეო კლიპს.</string>
    <string name="squeezer_markers_downscaled_description">ეს ფოტო სიგანით ან სიმაღლით 8192 პიქსელს აღემატება. შეკუმშვა ასევე ორჯერ ამცირებს მის გარჩევადობას.</string>

    <string name="squeezer_type_jpeg_title">JPEG</string>
    <string name="squeezer_type_jpeg_description">Sisällytä JPEG-kuvat (.jpg, .jpeg). Uudelleenpakkaus käyttää Androidin sisäänrakennettua JPEG-enkooderia. Päivämäärä, sijainti ja muut EXIF-metatiedot säilytetään.</string>
    <string name="squeezer_type_webp_title">WebP</string>
    <string name="squeezer_type_webp_description">Sisällytä WebP-kuvat (.webp). Uudelleenpakkaus käyttää Androidin sisäänrakennettua WebP-enkooderia. Päivämäärä, sijainti ja muut EXIF-metatiedot säilytetään.</string>
    <string name="squeezer_type_heic_title">HEIC/HEIF</string>
    <string name="squeezer_type_heic_description">Sisällytä HEIC/HEIF-kuvat (.heic, .heif). Päivämäärä, sijainti ja muut EXIF-metatiedot säilytetään. HDR-vahvistuskarttoja, syvyystietoja ja Live/Motion Photo -sisarkuvia ei voida säilyttää; tiedostot, jotka sisältävät useita kuvia, ohitetaan.</string>
    <string name="squeezer_type_video_title">MP4-video</string>
    <string name="squeezer_type_video_description">Sisällytä MP4-videotiedostot (.mp4). Videoraita pakataan uudelleen pienemmällä bittinopeudella laitteen omalla videoenkooderilla, äänirata kopioidaan muuttumattomana ja tiedosto pysyy MP4-muodossa.</string>
    <string name="squeezer_skip_compressed_title">Ohita aiemmin pakatut</string>
    <string name="squeezer_skip_compressed_description">Ohita tiedostot, jotka SD Maid on jo pakannut.</string>
    <string name="squeezer_exif_marker_title">Kirjoita EXIF-merkintä</string>
    <string name="squeezer_exif_marker_description">Lisää merkintä kuvan EXIF-käyttäjäkommenttikenttään estääksesi uudelleenpakkauksen vaikka pakkaushistoria tyhjennettäisiin.</string>
    <string name="squeezer_include_lossy_aux_title">Pakkaa HDR- &amp; syvyyskuvat</string>
    <string name="squeezer_include_lossy_aux_description">Sisällytä kuvat, joissa on HDR- tai syvyystietoa. Pakkaus poistaa sen: HDR-kuvista tulee tavallisia kuvia, ja muotokuvat menettävät taustan sumennukseen käytetyn tiedon. Usean kuvan HEIC-tiedostot ohitetaan edelleen.</string>
    <string name="squeezer_include_motion_photos_title">Pakkaa Motion Photo -kuvat</string>
    <string name="squeezer_include_motion_photos_description">Sisällytä Motion Photo -kuvat. Pakkaus säilyttää still-kuvan ja poistaa videopätkän.</string>
    <string name="squeezer_include_oversized_title">Pakkaa erittäin suuret kuvat</string>
    <string name="squeezer_include_oversized_description">Sisällytä kuvat, jotka ovat leveämpiä tai korkeampia kuin 8192 pikseliä. Pakkaus myös puolittaa niiden resoluution.</string>

    <string name="squeezer_min_size_title">最小檔案大小</string>
    <string name="squeezer_min_size_description">略過小於此大小的檔案。</string>
    <string name="squeezer_min_age_title">最小檔案年齡</string>
    <string name="squeezer_min_age_description">僅包含早於此時間的檔案。</string>
    <string name="squeezer_compression_settings_label">一般</string>
    <string name="squeezer_quality_description">品質越低，檔案越小，但視覺品質也越差。</string>
    <string name="squeezer_types_category_label">圖片設定</string>
    <string name="squeezer_protected_category_label">會遺失的內容</string>
    <string name="squeezer_video_settings_category_label">影片設定</string>
    <string name="squeezer_type_jpeg_title">JPEG</string>
    <string name="squeezer_type_jpeg_description">包含 JPEG 相片 (.jpg, .jpeg)。重新編碼使用 Android 內置的 JPEG 編碼器。日期、位置和其他 EXIF 中繼資料會保留。</string>
    <string name="squeezer_type_webp_title">WebP</string>
    <string name="squeezer_type_webp_description">包含 WebP 相片 (.webp)。重新編碼使用 Android 內置的 WebP 編碼器。日期、位置和其他 EXIF 中繼資料會保留。</string>
    <string name="squeezer_type_heic_title">HEIC/HEIF</string>
    <string name="squeezer_type_heic_description">包括 HEIC/HEIF 影像（.heic、.heif）。日期、位置和其他 EXIF 中繼資料會保留。無法保留 HDR 增益圖、深度資料和 Live/Motion Photo 伴檔；多影像檔案會略過。</string>
    <string name="squeezer_type_video_title">MP4 影片</string>
    <string name="squeezer_type_video_description">包含 MP4 影片檔 (.mp4)。影片軌道由裝置自身的影片編碼器以較低的位元速率重新編碼，音訊軌道保持不變並複製，檔案保持為 MP4。</string>
    <string name="squeezer_skip_compressed_title">跳過已壓縮的圖片</string>
    <string name="squeezer_skip_compressed_description">略過已由 SD Maid 壓縮的檔案。</string>
    <string name="squeezer_exif_marker_title">寫入 EXIF 標記</string>
    <string name="squeezer_exif_marker_description">在圖片的 EXIF 使用者註解欄位中附加標記，以防止即使壓縮歷史被清除也不會重新壓縮。</string>
    <string name="squeezer_include_lossy_aux_title">壓縮 HDR 與深度照片</string>
    <string name="squeezer_include_lossy_aux_description">包含具有 HDR 或景深資料的相片。壓縮會移除它：HDR 相片變成普通相片，人像相片會失去背景模糊背後的景深資料。多圖像 HEIC 檔案仍會被跳過。</string>
    <string name="squeezer_include_motion_photos_title">壓縮動感相片</string>
    <string name="squeezer_include_motion_photos_description">包含動感相片。壓縮會保留靜態圖像並移除影片片段。</string>
    <string name="squeezer_include_oversized_title">壓縮超大相片</string>
    <string name="squeezer_include_oversized_description">包含寬度或高度超過 8192 像素的相片。壓縮也會將其解析度減半。</string>
    <string name="squeezer_estimated_savings_format">約可節省 %s</string>
    <string name="squeezer_no_savings_expected">節省有限</string>
    <string name="squeezer_current_size_format">大小：%s</string>
    <string name="squeezer_chip_compressed_before">已壓縮</string>

    <string name="squeezer_type_jpeg_title">JPEG</string>
    <string name="squeezer_type_jpeg_description">JPEG súwretlerin qosıń (.jpg, .jpeg). Qayta kodlaw ushın Android-tıń ishki JPEG kodlawshısı qollanıladı. Sáne, orın hám basqa EXIF metamaǵlıwmatları saqlanadı.</string>
    <string name="squeezer_type_webp_title">WebP</string>
    <string name="squeezer_type_webp_description">WebP súwretlerin qosıń (.webp). Qayta kodlaw ushın Android-tıń ishki WebP kodlawshısı qollanıladı. Sáne, orın hám basqa EXIF metamaǵlıwmatları saqlanadı.</string>
    <string name="squeezer_type_heic_title">HEIC/HEIF</string>
    <string name="squeezer_type_heic_description">HEIC/HEIF súwretlerin (.heic, .heif) qosıw. Sáne, orın hám basqa EXIF maǵlıwmatları saqlanadı. HDR gain kartaları, tereńlik maǵlıwmatı hám Live/Motion Photo juwaptası saqlanbaydı; kóp-súwretli fayllar ótkerip jiberiledi.</string>
    <string name="squeezer_type_video_title">MP4 Video</string>
    <string name="squeezer_type_video_description">MP4 video fayllardı qosıń (.mp4). Video jol qurılmanıń óziniń video kodlawshısı arqalı tómenirek bit dárejesinde qayta kodlanadı, dawıs jolı ózgerissiz kóshiriledi, hám fayl MP4 kúyinde qaladı.</string>
    <string name="squeezer_skip_compressed_title">Aldın sıǵıstırılǵanlardı atlap o\'tiw</string>
    <string name="squeezer_skip_compressed_description">SD Maid tárepinen burın sıqılǵan fayllardy ótkirip jiberiw.</string>
    <string name="squeezer_exif_marker_title">EXIF belgini jazıw</string>
    <string name="squeezer_exif_marker_description">Su\'wrettiń EXIF paydalanıwshı ko\'rsetpesi maydan\'ına belgi qosıw, sıǵıstırıw tariyxı tazalanǵan jaǵdayda da qayta sıǵıstırıwdı aldın alıw ushin.</string>
    <string name="squeezer_include_lossy_aux_title">HDR hám tereńlik súwretlerin sıǵıw</string>
    <string name="squeezer_include_lossy_aux_description">HDR yamasa teren maǵlıwmatı bar súwretlerdi qosıń. Sıǵıw bul maǵlıwmattı alıp taslaydı: HDR súwretleri ádettegi súwretlerge aylanadı, portret súwretleri fon xiralatıwı ushın qollanılatuǵın maǵlıwmattan ayırıladı. Kóp súwretli HEIC fayllar ótkerip jiberilgen kúyinde qaladı.</string>
    <string name="squeezer_include_motion_photos_title">Motion Photo súwretlerin sıǵıw</string>
    <string name="squeezer_include_motion_photos_description">Motion Photo-lardı qosıń. Sıǵıw qozǵalmaytuǵın súwretti saqlap qaladı hám video úzindini alıp taslaydı.</string>
    <string name="squeezer_include_oversized_title">Júdá úlken súwretlerdi sıǵıw</string>
    <string name="squeezer_include_oversized_description">Eni yamasa biyikligi 8192 pikselden úlken súwretlerdi qosıń. Sıǵıw sonday-aq olardıń ajıratıw qábiletin eki ese kishireytedi.</string>

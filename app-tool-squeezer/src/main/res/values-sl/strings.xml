    <string name="squeezer_type_jpeg_title">JPEG</string>
    <string name="squeezer_type_jpeg_description">Vključi JPEG slike (.jpg, .jpeg). Ponovno kodiranje uporablja Androidov vgrajeni JPEG kodirnik. Datum, lokacija in drugi EXIF metapodatki so ohranjeni.</string>
    <string name="squeezer_type_webp_title">WebP</string>
    <string name="squeezer_type_webp_description">Vključi WebP slike (.webp). Ponovno kodiranje uporablja Androidov vgrajeni WebP kodirnik. Datum, lokacija in drugi EXIF metapodatki so ohranjeni.</string>
    <string name="squeezer_type_heic_title">HEIC/HEIF</string>
    <string name="squeezer_type_heic_description">Vključi slike HEIC/HEIF (.heic, .heif). Datum, lokacija in drugi metapodatki EXIF se ohranijo. Kart ojačitve HDR, podatkov o globini in povezanih datotek Live/Motion Photo ni mogoče ohraniti; datoteke z več slikami so preskočene.</string>
    <string name="squeezer_type_video_title">Videoposnetki MP4</string>
    <string name="squeezer_type_video_description">Vključi MP4 video datoteke (.mp4). Video sled je ponovno kodirana z nižje bitno hitrostjo z Androidovim video kodirnikom, zvočna sled pa ostane nespremenjena. Datoteka ostane MP4.</string>
    <string name="squeezer_skip_compressed_title">Preskoči že stisnjene</string>
    <string name="squeezer_skip_compressed_description">Preskoči datoteke, ki jih je SD Maid že stisnil.</string>
    <string name="squeezer_exif_marker_title">Zapiši oznako EXIF</string>
    <string name="squeezer_exif_marker_description">Dodaj oznako v polje uporabniškega komentarja oznak EXIF, da se prepreči ponovno stiskanje, tudi če je bila zgodovina stiskanja izbrisana.</string>
    <string name="squeezer_include_lossy_aux_title">Stisni fotografije s HDR-om in globino</string>
    <string name="squeezer_include_lossy_aux_description">Vključi fotografije s HDR ali podatki o globini. Kompresija jih odstrani: HDR fotografije postanejo običajne, portretne fotografije izgubijo podatke o globini. Večslojne HEIC datoteke ostanejo preskočene.</string>
    <string name="squeezer_include_motion_photos_title">Kompresiraj Motion fotografije</string>
    <string name="squeezer_include_motion_photos_description">Vključi Motion fotografije. Kompresija ohrani mirno sliko in odstrani video posnetek.</string>
    <string name="squeezer_include_oversized_title">Kompresiraj zelo velike fotografije</string>
    <string name="squeezer_include_oversized_description">Vključi fotografije, katerih širina ali višina presega 8192 pikslov. Kompresija tudi prepolovi njihovo ločljivost.</string>

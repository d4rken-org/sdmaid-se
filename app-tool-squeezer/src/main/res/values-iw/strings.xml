    <string name="squeezer_type_jpeg_title">JPEG</string>
    <string name="squeezer_type_jpeg_description">כלול תמונות JPEG (.jpg, .jpeg). קידוד מחדש משתמש במקודד ה-JPEG המובנה של Android. תאריך, מיקום ומידע EXIF נוסף נשמרים.</string>
    <string name="squeezer_type_webp_title">WebP</string>
    <string name="squeezer_type_webp_description">כלול תמונות WebP (.webp). קידוד מחדש משתמש במקודד ה-WebP המובנה של Android. תאריך, מיקום ומידע EXIF נוסף נשמרים.</string>
    <string name="squeezer_type_heic_title">HEIC/HEIF</string>
    <string name="squeezer_type_heic_description">כלול תמונות HEIC/HEIF (.heic, .heif). תאריך, מיקום ונתוני EXIF אחרים נשמרים. לא ניתן לשמר מפות HDR, נתוני עומק ותמונות Live/Motion Photo נלוות; קבצים רב-תמונתיים מדולגים.</string>
    <string name="squeezer_type_video_title">MP4 Video</string>
    <string name="squeezer_type_video_description">כלול קובצי וידאו MP4 (.mp4). ערוץ הווידאו מקודד מחדש בקצב סיביות נמוך יותר על ידי מקודד הווידאו של המכשיר, ערוץ השמע מועתק ללא שינוי, והקובץ נשאר MP4.</string>
    <string name="squeezer_skip_compressed_title">דלג על שנדחסו בעבר</string>
    <string name="squeezer_skip_compressed_description">דלג על קבצים שכבר דוחסו על ידי SD Maid.</string>
    <string name="squeezer_exif_marker_title">כתוב סמן EXIF</string>
    <string name="squeezer_exif_marker_description">הוסף סמן לשדה הערת המשתמש EXIF של התמונה כדי למנוע דחיסה חוזרת גם אם היסטוריית הדחיסה נמחקת.</string>
    <string name="squeezer_include_lossy_aux_title">דחוס תמונות HDR &amp; עומק</string>
    <string name="squeezer_include_lossy_aux_description">כלול תמונות עם נתוני HDR או עומק. הדחיסה מסירה אותם: תמונות HDR הופכות לתמונות רגילות, ותמונות פורטרט מאבדות את הנתונים שמאחורי טשטוש הרקע שלהן. קובצי HEIC מרובי-תמונה ממשיכים להידלג.</string>
    <string name="squeezer_include_motion_photos_title">דחיסת Motion Photos</string>
    <string name="squeezer_include_motion_photos_description">כלול Motion Photos. הדחיסה שומרת את התמונה הקבועה ומסירה את קטע הווידאו.</string>
    <string name="squeezer_include_oversized_title">דחיסת תמונות גדולות מאוד</string>
    <string name="squeezer_include_oversized_description">כלול תמונות שרוחבן או גובהן עולה על 8192 פיקסלים. הדחיסה גם מקטינה את הרזולוציה שלהן בחצי.</string>

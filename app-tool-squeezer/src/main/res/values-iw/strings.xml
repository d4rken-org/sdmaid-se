    <string name="squeezer_markers_dialog_title">על הסימונים האלה</string>
    <string name="squeezer_markers_compressed_before_description">SD Maid כבר דחס את הקובץ הזה. דחיסה חוזרת פוגעת באיכות וחוסכת מעט.</string>
    <string name="squeezer_markers_hdr_depth_description">לתמונה הזו יש נתוני HDR או עומק שהדחיסה לא יכולה לשמור. תמונת HDR הופכת לתמונה רגילה, ותמונת פורטרט מאבדת את נתוני העומק שמשמשים לטשטוש הרקע.</string>
    <string name="squeezer_markers_motion_photo_description">זוהי Motion Photo. הדחיסה שומרת את התמונה הקבועה ומסירה את קטע הווידאו.</string>
    <string name="squeezer_markers_downscaled_description">התמונה הזו רחבה או גבוהה מ-8192 פיקסלים. הדחיסה גם מקטינה את הרזולוציה שלה בחצי.</string>
